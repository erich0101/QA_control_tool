{
  "name": "manual-test-tool",
  "version": "1.0.0",
  "description": "Manual and visual testing tool for RAFAM2",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "setup": "npm install && npm run ui:install && npm run ui:build",
    "update": "npm install && npm run ui:install && npm run ui:build",
    "ui:install": "cd frontend && npm install",
    "ui:dev": "npm --prefix frontend run dev",
    "ui:build": "npm --prefix frontend run build",
    "ui:typecheck": "npm --prefix frontend run typecheck",
    "check:ui": "npm --prefix frontend run check:ui",
    "evidences:audit": "node tools/evidences-sync.js",
    "evidences:publish": "node tools/evidences-sync.js --publish",
    "verify-index": "node scripts/verify-index.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.107.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "pg": "^8.20.0",
    "sharp": "^0.34.5",
    "ws": "^8.20.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
