# =============================================================================
# QA Control Tool - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# =============================================================================

# --- Supabase (required) ---
# La app se conecta a Supabase via @supabase/supabase-js y ejecuta SQL
# a través de la función RPC `public.exec_query(query_text text)` que debe
# existir en el schema remoto.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_KEY

# --- DB driver ---
# 'supabase' (default) o 'postgres' (driver nativo via pg.Pool).
DB_IMPL=supabase

# --- Postgres (solo si DB_IMPL=postgres) ---
# Conexión TCP directa, alternativa a Supabase.
# Para Neon, Supabase Pooler, RDS, o Postgres local.
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# --- JWT auth (required) ---
# 32+ chars hex. Used to sign session cookies.
JWT_SECRET=

# --- Jira encryption (required) ---
# 64 hex chars (32 bytes). AES-256 key used by src/services/crypto.service.js
# to encrypt Jira API tokens at rest in qa_jira_user_configs.encrypted_token.
JIRA_ENCRYPTION_KEY=

# --- Optional: server config ---
# PORT=3001
# NODE_ENV=production
# LOG_LEVEL=info

# --- Optional: CORS ---
# Comma-separated list of allowed origins, or unset to disable CORS.
# CORS_ORIGIN=https://app.example.com
