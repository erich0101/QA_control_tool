# =============================================================================
# QA Control Tool - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# =============================================================================

# --- PostgreSQL (required) ---
# Used by docker-compose to provision the DB container, and by the app to connect.
POSTGRES_PASSWORD=change_me_secure_password
PGUSER=qa_user
PGDATABASE=qa_db

# --- JWT auth (required) ---
# 32+ chars hex. Used to sign session cookies.
JWT_SECRET=

# --- Jira encryption (required) ---
# 64 hex chars (32 bytes). AES-256 key used by src/services/crypto.service.js
# to encrypt Jira API tokens at rest in qa_jira_user_configs.encrypted_token.
JIRA_ENCRYPTION_KEY=

# --- Optional: server config ---
# PORT=3001
# NODE_ENV=production
# LOG_LEVEL=info

# --- Optional: CORS ---
# Comma-separated list of allowed origins, or unset to disable CORS.
# CORS_ORIGIN=https://app.example.com

# --- Optional: DB pool tuning ---
# PG_POOL_MAX=10
