# =============================================================================
# QA Control Tool - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# =============================================================================

# --- Database (required) ---
# The app is DB-agnostic: point to any Postgres reachable over TCP.
# Pick ONE of the two equivalent forms below.

# (A) DATABASE_URL — preferred. Works with Neon, Supabase, RDS, any local Postgres.
#     Examples:
#       Neon:    postgresql://neondb_owner:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
#       Supabase: postgresql://postgres.[ref]:pass@aws-0-region.pooler.supabase.com:5432/postgres
#       Local:   postgresql://qa_user:pass@db:5432/qa_control_tool
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# (B) libpq-style variables — used automatically if DATABASE_URL is unset.
# PGHOST=localhost
# PGPORT=5432
# PGUSER=qa_user
# PGPASSWORD=change_me
# PGDATABASE=qa_control_tool
# PGSSLMODE=require

# --- DB driver (advanced) ---
# Default: 'pg'. Set to 'memory' for tests/dev without a DB (no production).
DB_DRIVER=pg

# --- JWT auth (required) ---
# 32+ chars hex. Used to sign session cookies.
JWT_SECRET=

# --- Jira encryption (required) ---
# 64 hex chars (32 bytes). AES-256 key used by src/services/crypto.service.js
# to encrypt Jira API tokens at rest in qa_jira_user_configs.encrypted_token.
JIRA_ENCRYPTION_KEY=

# --- Optional: server config ---
# PORT=3001
# NODE_ENV=production
# LOG_LEVEL=info

# --- Optional: CORS ---
# Comma-separated list of allowed origins, or unset to disable CORS.
# CORS_ORIGIN=https://app.example.com

# --- Optional: DB pool tuning ---
# DB_POOL_MAX=10
# DB_CONNECT_TIMEOUT_MS=10000
# DB_STATEMENT_TIMEOUT_MS=30000
