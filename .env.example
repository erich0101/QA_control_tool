# ──────────────────────────────────────────────────────────────────────
# PLANTILLA DE VARIABLES DE ENTORNO
# ──────────────────────────────────────────────────────────────────────
# Copia este archivo a `.env` y reemplaza los valores entre <...>
# con tus propias llaves generadas.
#
# IMPORTANTE:
#   - NUNCA commitees tu `.env` real (ya está en .gitignore).
#   - NUNCA uses las llaves de otra persona/departamento.
#   - Cada departamento debe generar SUS PROPIAS llaves.
# ──────────────────────────────────────────────────────────────────────

# ── Conexión a Supabase (OBLIGATORIO) ────────────────────────────────
# Obtener desde: Supabase Dashboard → Project Settings → API
# Usa la clave "service_role" (NO la "anon").
SUPABASE_URL=https://<TU-PROYECTO>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<TU-SERVICE-ROLE-KEY>

# ── Puerto local del servidor ────────────────────────────────────────
PORT=3001

# ── Llaves de seguridad (OBLIGATORIO) ────────────────────────────────
# JWT_SECRET: firma de sesiones (cualquier cadena larga y aleatoria).
# JIRA_ENCRYPTION_KEY: AES-256-CBC; se aceptan 32 caracteres o 64 hex.
# Generar cada una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<GENERA-32-BYTES-HEX>
JIRA_ENCRYPTION_KEY=<GENERA-32-BYTES-HEX>

# ── Evidencias (opcional) ────────────────────────────────────────────
# Tope en bytes para guardar una copia del binario en Postgres
# (qa_attachments.file_data) y que sea portable entre máquinas.
# Default: 10485760 (10 MB).
# EVIDENCE_EMBED_MAX_BYTES=10485760

# ── Opcionales: Integraciones externas ──────────────────────────────
# Descomenta y completa solo si las usas.
# FIGMA_ACCESS_TOKEN=
# FIGMA_PROJECT_URL=
# GEMINI_API_KEY=
# JIRA_TIKEN=
